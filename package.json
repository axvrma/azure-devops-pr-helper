{
    "name": "azure-devops-pr-helper",
    "displayName": "Azure DevOps PR Helper",
    "description": "Create Azure DevOps pull requests and visually plan branch integration with Branch Flow Manager and optional AI assistance",
    "publisher": "axvrma",
    "version": "1.1.3",
    "license": "MIT",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#0078d4",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/axvrma/azure-devops-pr-helper"
    },
    "bugs": {
        "url": "https://github.com/axvrma/azure-devops-pr-helper/issues"
    },
    "homepage": "https://github.com/axvrma/azure-devops-pr-helper#readme",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other",
        "SCM Providers"
    ],
    "keywords": [
        "azure devops",
        "pull request",
        "pr",
        "anthropic",
        "gemini",
        "openai",
        "ai",
        "git",
        "devops",
        "automation",
        "branch flow",
        "release management"
    ],
    "activationEvents": [
        "onCommand:extension.raisePR",
        "onCommand:extension.openPRCreator",
        "onCommand:extension.copyPrUrl",
        "onCommand:extension.clearPAT",
        "onCommand:extension.openSettings",
        "onCommand:extension.generateAITitle",
        "onView:prHelperSidebarView",
        "onCommand:extension.openBranchFlow",
        "onCustomEditor:azureDevopsPr.branchFlow"
    ],
    "scripts": {
        "vscode:package": "npm run verify && vsce package --no-dependencies",
        "vscode:prepublish": "npm run compile",
        "compile": "npm run typecheck && node scripts/build.mjs && vite build --config webview/vite.config.mts && npm run licenses",
        "watch": "node scripts/build.mjs --watch",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
        "lint": "eslint src webview/src test --ext .ts,.tsx",
        "test": "vitest run",
        "test:extension": "npm run compile && node scripts/test-extension.mjs",
        "verify": "npm run typecheck && npm run lint && npm test && npm run compile",
        "package:inspect": "vsce ls --no-dependencies --tree",
        "test:browser": "npm run compile && playwright test",
        "licenses": "node scripts/licenses.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/vscode": "1.60.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^8.0.0",
        "jsdom": "^28.0.0",
        "typescript": "^5.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@xyflow/react": "^12.12.0",
        "abort-controller": "^3.0.0",
        "axios": "^1.6.0",
        "posthog-node": "^3.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.openPRCreator",
                "title": "Create Pull Request",
                "category": "Azure DevOps",
                "icon": "$(git-pull-request)"
            },
            {
                "command": "extension.raisePR",
                "title": "Raise PR",
                "category": "Azure DevOps",
                "icon": "$(git-pull-request)"
            },
            {
                "command": "extension.copyPrUrl",
                "title": "Copy Last PR URL",
                "category": "Azure DevOps",
                "icon": "$(copy)"
            },
            {
                "command": "extension.clearPAT",
                "title": "Clear Azure DevOps PAT",
                "category": "Azure DevOps",
                "icon": "$(trash)"
            },
            {
                "command": "extension.openSettings",
                "title": "Open Settings",
                "category": "Azure DevOps",
                "icon": "$(gear)"
            },
            {
                "command": "extension.generateAITitle",
                "title": "Generate PR Title with AI",
                "category": "Azure DevOps",
                "icon": "$(sparkle)"
            },
            {
                "command": "extension.openBranchFlow",
                "title": "Open Branch Flow",
                "category": "Azure DevOps",
                "icon": "$(git-merge)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "azureDevopsPr",
                    "title": "Azure DevOps PR",
                    "icon": "$(git-pull-request)"
                }
            ]
        },
        "views": {
            "azureDevopsPr": [
                {
                    "type": "webview",
                    "id": "prHelperSidebarView",
                    "name": "PR Helper"
                }
            ]
        },
        "configuration": {
            "title": "Azure DevOps PR Helper",
            "properties": {
                "azureDevopsPr.orgHost": {
                    "type": "string",
                    "default": "https://dev.azure.com/your-org",
                    "description": "Azure DevOps organization URL (e.g., https://dev.azure.com/your-org or https://your-org.visualstudio.com)"
                },
                "azureDevopsPr.project": {
                    "type": "string",
                    "default": "your-project",
                    "description": "Azure DevOps project name"
                },
                "azureDevopsPr.useAI": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use the selected AI provider to generate PR title and description suggestions"
                },
                "azureDevopsPr.generateDescription": {
                    "type": "boolean",
                    "default": true,
                    "description": "Also generate PR description when using AI"
                },
                "azureDevopsPr.autoAcceptAI": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically accept AI-generated title and description without prompting"
                },
                "azureDevopsPr.aiProvider": {
                    "type": "string",
                    "default": "anthropic",
                    "enum": [
                        "anthropic",
                        "gemini",
                        "openai"
                    ],
                    "enumDescriptions": [
                        "Anthropic",
                        "Google Gemini",
                        "OpenAI"
                    ],
                    "description": "AI provider to use for PR title and description generation"
                },
                "azureDevopsPr.aiModel": {
                    "type": "string",
                    "default": "",
                    "description": "Model id for the selected AI provider. Leave blank to use the provider default."
                },
                "azureDevopsPr.aiMaxTokens": {
                    "type": "number",
                    "default": 1024,
                    "minimum": 100,
                    "maximum": 4096,
                    "description": "Maximum tokens for AI provider responses"
                },
                "azureDevopsPr.aiTemperature": {
                    "type": "number",
                    "default": 0.3,
                    "minimum": 0,
                    "maximum": 2,
                    "description": "Temperature for AI generation"
                },
                "azureDevopsPr.apiVersion": {
                    "type": "string",
                    "default": "7.1",
                    "description": "Azure DevOps REST API version"
                },
                "azureDevopsPr.enableTelemetry": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable anonymous usage analytics to help improve the extension"
                },
                "azureDevopsPr.branchFlow.pollIntervalSeconds": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 3600,
                    "description": "Branch Flow polling interval. 0 disables polling; positive intervals have a 30-second minimum."
                },
                "azureDevopsPr.branchFlow.localAnalysis": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow isolated local Git analysis in trusted workspaces when the exact Azure commits already exist locally. Never fetches."
                }
            }
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "extension.openPRCreator",
                    "when": "workspaceFolderCount > 0"
                },
                {
                    "command": "extension.raisePR",
                    "when": "workspaceFolderCount > 0"
                },
                {
                    "command": "extension.copyPrUrl"
                },
                {
                    "command": "extension.clearPAT"
                },
                {
                    "command": "extension.openSettings"
                },
                {
                    "command": "extension.generateAITitle",
                    "when": "workspaceFolderCount > 0"
                }
            ],
            "view/title": [
                {
                    "command": "extension.openBranchFlow",
                    "when": "view == prHelperSidebarView",
                    "group": "navigation"
                },
                {
                    "command": "extension.openPRCreator",
                    "when": "view == prHelperSidebarView",
                    "group": "navigation"
                },
                {
                    "command": "extension.openSettings",
                    "when": "view == prHelperSidebarView",
                    "group": "navigation"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "azureDevopsPr.branchFlow",
                "displayName": "Branch Flow Manager",
                "selector": [
                    {
                        "filenamePattern": "*.branchflow.json"
                    }
                ],
                "priority": "default"
            }
        ]
    },
    "overrides": {
        "@vscode/vsce": {
            "@azure/identity": "4.13.0",
            "@azure/msal-node": {
                "uuid": "^11.1.1"
            }
        }
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Azure planning and local graph files are available. Local Git simulation is disabled until the workspace is trusted."
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "Azure analysis is available; graph saves and Git simulation require a local filesystem."
        }
    }
}
